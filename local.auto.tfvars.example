elastic_cloud_organization = "<your-elastic-cloud-org>"
aws_region                 = "eu-north-1"
aws_profile                = "<your-aws-profile>"
elastic_version            = "9.5.x"
alert_email_recipients     = ["<you@example.com>"]
tags = {
  owner      = "<you>"
  purpose    = "<purpose>"
  expires_at = "<YYYY-MM-DD>"
}

# Optional overrides (defaults shown)
# prefix                   = "obs95-demo"
# kubernetes_version       = "1.34"
# kube_stack_chart_version = "0.16.0"
# image_build_tool         = "docker"
# image_platform           = "linux/amd64"
# loadgen_rate             = 5
# eks_api_allowed_cidrs    = []  # empty = your current public IP /32
